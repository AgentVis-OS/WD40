<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo sync integration for AIPhoneAssistant + WD40.

  Copy to .repo/local_manifests/wd40.xml, then:
      repo sync aiphone_assistant WD40
  App lands in packages/apps/AIPhoneAssistant; this repo lands in
  vendor/wd40 (the paths the lunch products and sepolicy dirs expect).

-->
<manifest>
    <remote name="agentvis" fetch="https://github.com/AgentVis-OS" />

    <project name="aiphone_assistant" path="packages/apps/AIPhoneAssistant"
             remote="agentvis" revision="main" />
    <project name="WD40" path="vendor/wd40"
             remote="agentvis" revision="main" />
</manifest>
