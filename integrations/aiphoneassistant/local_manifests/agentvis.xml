<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo sync integration for AIPhoneAssistant + WD40.

  Copy to .repo/local_manifests/agentvis.xml, then:
      repo sync aiphone_assistant WD40
  App lands in packages/apps/AIPhoneAssistant; this repo lands in
  vendor/agentvis (the paths agentvis.mk / sepolicy dirs expect).

  NOTE: remotes below point at the personal GitHub accounts until the
  AgentVisOS org repos exist — switch `remote` then.
-->
<manifest>
    <remote name="agentvis" fetch="https://github.com/AgentVisOS" />
    <remote name="personal" fetch="https://github.com/Inokinoki" />

    <project name="aiphone_assistant" path="packages/apps/AIPhoneAssistant"
             remote="personal" revision="main" />
    <project name="WD40" path="vendor/agentvis"
             remote="personal" revision="main" />
</manifest>
